# Handle line endings automatically for files detected as text 
# and leave binary files untouched.
* text=auto

# Force LF for specific file types that should always use them
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
.env* text eol=lf
